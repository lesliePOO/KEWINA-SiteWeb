# Numéro WhatsApp de KEWINA, format international sans « + » ni espaces (ex. 2376XXXXXXXX).
# À renseigner dans les variables d'environnement Vercel. Seule source du numéro dans le code.
VITE_WHATSAPP_NUMBER=

# Supabase (projet « kewina »). Clé publique uniquement : la sécurité repose sur les règles RLS.
# Ne jamais mettre de clé secrète (service_role) dans une variable VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
